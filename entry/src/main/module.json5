{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "querySchemes": ["ftp", "file", "mailto"],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          {
            // Answers ss:// links, so a profile a provider hands out as a link
            // or a QR code can be opened straight into the app.
            "actions": ["ohos.want.action.viewData"],
            "uris": [{ "scheme": "ss" }]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "SsVpnExtensionAbility",
        "srcEntry": "./ets/vpnability/SsVpnExtensionAbility.ets",
        "description": "$string:vpn_ability_desc",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "type": "vpn",
        "exported": false
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        // proxy mode runs the core in this process, which the platform freezes
        // in the background without a continuous task
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        // resolves a bundle name the app picker stores into a bundle record;
        // normal grant, no runtime prompt
        "name": "ohos.permission.GET_BUNDLE_INFO"
      }
    ]
  }
}
