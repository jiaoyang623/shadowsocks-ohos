  "decisions": [
    {
      "id": "D-01",
      "priority": "P0",
      "question": "Does one shared field set serve every unit that changes a profile?",
      "reason": "Five units change the profile record and the settings record.",
      "options": [
        {
          "id": "A",
          "label": "One reconciled record",
          "description": "One owner sets the fields and every unit uses them.",
          "consequences": "The export keeps the Android shape. No unit invents a second name for one value.",
          "recommended": true
        },
        {
          "id": "B",
          "label": "One record per unit",
          "description": "Each unit adds its own fields and helpers.",
          "consequences": "Two fields would carry one Android value and the export would drift.",
          "recommended": false
        }
      ],
      "recommendation": "A",
