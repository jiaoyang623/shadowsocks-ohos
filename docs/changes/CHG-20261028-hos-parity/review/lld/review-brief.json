    {
      "id": "D-02",
      "priority": "P0",
      "question": "Should the model land before the pages?",
      "reason": "Pages call model functions. A page written against a guessed signature fails at build time.",
      "options": [
        {
          "id": "A",
          "label": "Model first, pages second",
          "description": "Finish the model wave, then start the page wave.",
          "consequences": "Pages compile against the real API. One extra wave of wall time.",
          "recommended": true
        },
        {
          "id": "B",
          "label": "One unit at a time",
          "description": "Build each unit from model to page in sequence.",
          "consequences": "Shared files would be edited by many owners in turn and conflicts would repeat.",
          "recommended": false
        }
      ],
      "recommendation": "A",
      "affected_design_ids": [
        "HLD-C01",
        "HLD-C02",
        "HLD-C05",
        "HLD-C06",
        "HLD-C07",
        "HLD-C08"
      ]
    },
    {
      "id": "D-03",
      "priority": "P1",
      "question": "Is one owner per shared file enough to prevent conflicting edits?",
      "reason": "Several units change the same page, the same model file and the same manifest.",
      "options": [
        {
          "id": "A",
          "label": "One owner per file",
          "description": "The owner reads every unit plan for that file and reconciles them.",
          "consequences": "The edits apply once and in one order. Each owner must read more context.",
          "recommended": true
        },
        {
          "id": "B",
          "label": "One owner per unit",
          "description": "Each unit edits its files directly.",
          "consequences": "Concurrent writes to the same file overwrite each other.",
          "recommended": false
        }
      ],
      "recommendation": "A",
