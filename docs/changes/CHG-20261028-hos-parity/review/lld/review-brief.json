      "id": "D-04",
      "priority": "P1",
      "question": "Are the platform limits acceptable for this release?",
      "reason": "Some Android surfaces have no public HarmonyOS API.",
      "options": [
        {
          "id": "A",
          "label": "Accept the limits",
          "description": "Record each limit and implement the closest behavior.",
          "consequences": "The release can ship. A few app-picker and system-surface cases stay partial.",
          "recommended": true
        },
        {
          "id": "B",
          "label": "Block on the platform",
          "description": "Wait for a public API for every gap.",
          "consequences": "The release waits with no end date.",
          "recommended": false
        }
      ],
      "recommendation": "A",
      "affected_design_ids": [
        "LLD-U07",
        "LLD-U10",
        "LLD-U11",
        "HLD-C07",
        "HLD-C08"
      ]
    }
